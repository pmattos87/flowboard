{
  "boardKey": ["FB", "SF"],
  "branches": { "integration": "develop", "production": "main" },
  "gates": [
    "npx tsc --noEmit",
    "npx vitest run",
    "cargo test --manifest-path src-tauri/Cargo.toml"
  ],
  "build": ["npm run build"],
  "ci": {
    "node": "22",
    "rust": "stable",
    "rustWorkspace": "src-tauri",
    "apt": ["libwebkit2gtk-4.1-dev", "build-essential", "libxdo-dev", "libssl-dev", "libayatana-appindicator3-dev", "librsvg2-dev"],
    "install": ["npm ci", "mkdir -p dist"]
  }
}
