{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    { "identifier": "fs:allow-stat", "allow": [{ "path": "$HOME/**" }] },
    "notification:default",
    { "identifier": "opener:allow-open-path", "allow": [{ "path": "$HOME/**" }] },
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://github.com/*" }] },
    "sql:default"
  ]
}
